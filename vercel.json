{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    { "source": "/demos/:path*", "destination": "/demos/:path*" }
  ],
  "headers": [
    {
      "source": "/demos/sharedarraybuffer-atomics-workers.html",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    },
    {
      "source": "/demos/sab-wall-probe-coop.html",
      "headers": [
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/demos/tt-csp-strict.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "require-trusted-types-for 'script'" }
      ]
    },
    {
      "source": "/demos/tt-csp-default.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "require-trusted-types-for 'script'; trusted-types tt-demo default" }
      ]
    }
  ]
}
